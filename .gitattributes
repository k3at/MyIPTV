# Normalise line endings so the Linux CI runner can execute gradlew.
# Without this, Windows checkouts push CRLF and the workflow dies with
# "/usr/bin/env: 'bash\r': No such file or directory".
* text=auto eol=lf

# Windows-only tooling must keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper script must be executable in the repository index.
gradlew text eol=lf

# Never mangle binaries.
*.png binary
*.jpg binary
*.webp binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.jar binary
