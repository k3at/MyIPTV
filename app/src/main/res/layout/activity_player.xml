<?xml version="1.0" encoding="utf-8"?>
<!--
  Fullscreen player. PlayerView renders the video only (use_controller=false);
  every control is our own overlay so we can offer play/pause, seek, volume,
  brightness, aspect ratio and playback speed on phones and TV remotes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- ── Top info bar (shown with the OSD) ─────────────────────────── -->
    <LinearLayout
        android:id="@+id/overlayTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/playerChannelLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/placeholder_channel"
            android:contentDescription="@string/cd_channel_logo"
            android:padding="3dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playerChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerChannelCat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/playerEpgText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="@color/brand_accent"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/favBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/cd_favorite"
            android:focusable="false"
            android:padding="8dp"
            android:src="@drawable/ic_star_border"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ── Big centre transport (touch) ──────────────────────────────── -->
    <LinearLayout
        android:id="@+id/centerPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/centerRewBtn"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/cd_rewind"
            android:focusable="false"
            android:padding="16dp"
            android:src="@drawable/ic_rewind"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/centerPlayBtn"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/cd_play_pause"
            android:focusable="false"
            android:padding="18dp"
            android:src="@drawable/ic_play"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/centerFwdBtn"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/cd_forward"
            android:focusable="false"
            android:padding="16dp"
            android:src="@drawable/ic_forward"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- ── Transient volume / brightness feedback ────────────────────── -->
    <LinearLayout
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="40dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:minWidth="150dp"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/indicatorIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/cd_volume"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/indicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Bottom control bar (shown with the OSD) ───────────────────── -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <!-- progress row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/positionText"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:focusable="false"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/brand_accent"
                android:splitTrack="false"
                android:thumbTint="@color/brand_accent" />

            <TextView
                android:id="@+id/durationText"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/liveChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/live_badge"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prevBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_prev"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/rewBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_rewind"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/ic_rewind"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/playBtn"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_play_pause"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_play"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/fwdBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_forward"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/ic_forward"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/nextBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_next"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/aspectBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/player_aspect"
                android:focusable="false"
                android:minWidth="62dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:text="@string/aspect_fit"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speedBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/player_speed"
                android:focusable="false"
                android:minWidth="62dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/muteBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_mute"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/openListBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_open_list"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/ic_list"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- volume / brightness row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/volumeIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/cd_volume"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/text_secondary" />

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:focusable="false"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/brand_accent"
                android:splitTrack="false"
                android:thumbTint="@color/brand_accent" />

            <TextView
                android:id="@+id/volumeValue"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/brightnessIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="24dp"
                android:contentDescription="@string/cd_brightness"
                android:src="@drawable/ic_brightness"
                app:tint="@color/text_secondary" />

            <SeekBar
                android:id="@+id/brightnessBar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:focusable="false"
                android:max="100"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/brand_accent"
                android:splitTrack="false"
                android:thumbTint="@color/brand_accent" />

            <TextView
                android:id="@+id/brightnessValue"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Channel drawer ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/channelDrawer"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/drawerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/channels"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playerChannelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- ── Error / buffering ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/playerErrorGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/playerProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/playerErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/playback_error"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playerRetryBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
