<?xml version="1.0" encoding="utf-8"?>
<!-- In-app connection settings. Works on phones and TV boxes (scrollable, D-pad friendly). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_back"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/app_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- One chip per saved panel, then the add / remove actions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelInline"
                android:text="@string/settings_profiles" />

            <HorizontalScrollView
                android:id="@+id/profileScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/profileRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/profileAddBtn"
                style="@style/SettingsChip"
                android:layout_marginStart="10dp"
                android:text="@string/settings_profile_add" />

            <TextView
                android:id="@+id/profileDelBtn"
                style="@style/SettingsChip"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/settings_profile_remove"
                android:text="@string/settings_profile_remove_glyph" />
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="12dp"
            android:text="@string/settings_server" />

        <EditText
            android:id="@+id/serverInput"
            style="@style/FieldInput"
            android:hint="@string/settings_server_hint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_username" />

        <EditText
            android:id="@+id/usernameInput"
            style="@style/FieldInput"
            android:hint="@string/settings_username_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_password" />

        <EditText
            android:id="@+id/passwordInput"
            style="@style/FieldInput"
            android:hint="@string/settings_password_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelInline"
                android:text="@string/settings_live_format" />

            <TextView
                android:id="@+id/chipHls"
                style="@style/SettingsChip"
                android:layout_marginStart="10dp"
                android:text="@string/settings_hls" />

            <TextView
                android:id="@+id/chipTs"
                style="@style/SettingsChip"
                android:layout_marginStart="6dp"
                android:text="@string/settings_ts" />
        </LinearLayout>

        <!-- Language. Applied as soon as it is tapped. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelInline"
                android:text="@string/settings_language" />

            <TextView
                android:id="@+id/chipSystem"
                style="@style/SettingsChip"
                android:layout_marginStart="10dp"
                android:text="@string/language_system" />

            <TextView
                android:id="@+id/chipEnglish"
                style="@style/SettingsChip"
                android:layout_marginStart="6dp"
                android:text="@string/language_en" />

            <TextView
                android:id="@+id/chipArabic"
                style="@style/SettingsChip"
                android:layout_marginStart="6dp"
                android:text="@string/language_ar" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_error_fields"
            android:textColor="@color/brand_accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/settings_security_note"
            android:textColor="@color/text_disabled"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
