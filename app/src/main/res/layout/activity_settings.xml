<?xml version="1.0" encoding="utf-8"?>
<!-- In-app connection settings. Works on phones and TV boxes (scrollable, D-pad friendly). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/cd_back"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/cd_logo"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Source type -->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_source" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabXtream"
                style="@style/TabText"
                android:text="@string/settings_xtream" />

            <TextView
                android:id="@+id/tabM3u"
                style="@style/TabText"
                android:layout_marginStart="8dp"
                android:text="@string/settings_m3u" />
        </LinearLayout>

        <!-- Xtream group -->
        <LinearLayout
            android:id="@+id/xtreamGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/settings_server" />

            <EditText
                android:id="@+id/serverInput"
                style="@style/FieldInput"
                android:hint="@string/settings_server_hint"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView
                style="@style/FieldLabel"
                android:text="@string/settings_username" />

            <EditText
                android:id="@+id/usernameInput"
                style="@style/FieldInput"
                android:hint="@string/settings_username_hint"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                style="@style/FieldLabel"
                android:text="@string/settings_password" />

            <EditText
                android:id="@+id/passwordInput"
                style="@style/FieldInput"
                android:hint="@string/settings_password_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                style="@style/FieldLabel"
                android:text="@string/settings_live_format" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipHls"
                    style="@style/TabText"
                    android:text="@string/settings_hls" />

                <TextView
                    android:id="@+id/chipTs"
                    style="@style/TabText"
                    android:layout_marginStart="8dp"
                    android:text="@string/settings_ts" />
            </LinearLayout>
        </LinearLayout>

        <!-- M3U group -->
        <LinearLayout
            android:id="@+id/m3uGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/settings_m3u" />

            <EditText
                android:id="@+id/m3uInput"
                style="@style/FieldInput"
                android:hint="@string/settings_m3u_hint"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_error_fields"
            android:textColor="@color/brand_accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/settings_security_note"
            android:textColor="@color/text_disabled"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
